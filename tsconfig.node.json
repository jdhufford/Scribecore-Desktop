{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsc-node/tsconfig.tsbuildinfo",
    "paths": {
      "better-sqlite3-multiple-ciphers": [
        "./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
